rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isPositiveNumber(val) {
      return val is number && val > 0;
    }

    function isNonNegNumber(val) {
      return val is number && val >= 0;
    }

    function isDateStr(val) {
      return val is string && val.size() == 10;
    }

    // Validate weight field if present — must be a realistic number
    function validWeight(data) {
      return !('weight' in data)
        || (data.weight is number && data.weight > 20 && data.weight < 500);
    }

    function validHeight(data) {
      return !('height' in data)
        || (data.height is number && data.height > 50 && data.height < 300);
    }

    function validTargetWeight(data) {
      return !('targetWeight' in data)
        || (data.targetWeight is number && data.targetWeight > 20 && data.targetWeight < 500);
    }

    function validAge(data) {
      return !('age' in data)
        || (data.age is number && data.age >= 13 && data.age <= 120);
    }

    // ============================================================
    // USER PROFILE
    // ============================================================
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Allow create for any authenticated user writing their own doc
      allow create: if isOwner(userId)
        && validWeight(request.resource.data)
        && validHeight(request.resource.data)
        && validAge(request.resource.data);

      // Allow update — same field-level validation, no required-field checks
      // (merge writes may only include changed fields, not the full profile)
      allow update: if isOwner(userId)
        && validWeight(request.resource.data)
        && validHeight(request.resource.data)
        && validTargetWeight(request.resource.data)
        && validAge(request.resource.data);

      // ── WEIGHT ENTRIES ──────────────────────────────────────
      match /weights/{weightId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isPositiveNumber(request.resource.data.weight)
          && request.resource.data.weight > 20
          && request.resource.data.weight < 500
          && isDateStr(request.resource.data.date);

        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── MEALS ───────────────────────────────────────────────
      match /meals/{mealId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isPositiveNumber(request.resource.data.grams)
          && request.resource.data.grams <= 5000
          && isDateStr(request.resource.data.date)
          && request.resource.data.foodItem is map
          && isNonNegNumber(request.resource.data.foodItem.calories)
          && request.resource.data.foodItem.calories <= 10000;

        allow delete: if isOwner(userId);
      }

      // ── WATER ───────────────────────────────────────────────
      match /water/{waterId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isPositiveNumber(request.resource.data.amount)
          && request.resource.data.amount <= 5000
          && isDateStr(request.resource.data.date);

        allow delete: if isOwner(userId);
      }

      // ── WORKOUTS ────────────────────────────────────────────
      match /workouts/{workoutId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && request.resource.data.name is string
          && isDateStr(request.resource.data.date)
          && request.resource.data.exercises is list;

        allow delete: if isOwner(userId);
      }

      // ── WORKOUT TEMPLATES ───────────────────────────────────
      match /workoutTemplates/{templateId} {
        allow read, write: if isOwner(userId);
      }

      // ── PERSONAL RECORDS ────────────────────────────────────
      match /personalRecords/{exerciseId} {
        allow read: if isOwner(userId);

        allow write: if isOwner(userId)
          && request.resource.data.exerciseId is string
          && isNonNegNumber(request.resource.data.weightKg)
          && isPositiveNumber(request.resource.data.reps);

        allow delete: if isOwner(userId);
      }

      // ── MEASUREMENTS ────────────────────────────────────────
      match /measurements/{measurementId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isDateStr(request.resource.data.date);

        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── HABITS ──────────────────────────────────────────────
      match /habits/{habitId} {
        allow read, write: if isOwner(userId);
      }

      // ── PROGRESS PHOTOS ─────────────────────────────────────
      match /progressPhotos/{photoId} {
        allow read, write: if isOwner(userId);
      }

      // ── STREAKS ─────────────────────────────────────────────
      match /streaks/{streakId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================================
    // SHARED FOOD DATABASE — read-only for authenticated users
    // ============================================================
    match /foods/{foodId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /foodCache/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /indianFoods/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /exerciseCache/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ============================================================
    // DENY EVERYTHING ELSE
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
