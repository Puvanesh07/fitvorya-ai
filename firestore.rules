rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isString(val) {
      return val is string && val.size() > 0;
    }

    function isPositiveNumber(val) {
      return val is number && val > 0;
    }

    function isNonNegNumber(val) {
      return val is number && val >= 0;
    }

    function isDateStr(val) {
      // YYYY-MM-DD format, basic length check
      return val is string && val.size() == 10;
    }

    // ============================================================
    // USER PROFILE
    // ============================================================
    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId);

      allow update: if isOwner(userId)
        // Weight must be a realistic number if provided
        && (!('weight' in request.resource.data)
            || (request.resource.data.weight is number
                && request.resource.data.weight > 20
                && request.resource.data.weight < 500))
        // Height in cm
        && (!('height' in request.resource.data)
            || (request.resource.data.height is number
                && request.resource.data.height > 50
                && request.resource.data.height < 300))
        // Target weight
        && (!('targetWeight' in request.resource.data)
            || (request.resource.data.targetWeight is number
                && request.resource.data.targetWeight > 20
                && request.resource.data.targetWeight < 500))
        // Age
        && (!('age' in request.resource.data)
            || (request.resource.data.age is number
                && request.resource.data.age >= 13
                && request.resource.data.age <= 120));

      // ── WEIGHT ENTRIES ──────────────────────────────────────
      match /weights/{weightId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isPositiveNumber(request.resource.data.weight)
          && request.resource.data.weight > 20
          && request.resource.data.weight < 500
          && isDateStr(request.resource.data.date);

        allow update: if isOwner(userId)
          && (!('weight' in request.resource.data)
              || (isPositiveNumber(request.resource.data.weight)
                  && request.resource.data.weight > 20
                  && request.resource.data.weight < 500));

        allow delete: if isOwner(userId);
      }

      // ── MEALS ───────────────────────────────────────────────
      match /meals/{mealId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isPositiveNumber(request.resource.data.grams)
          && request.resource.data.grams <= 5000
          && isDateStr(request.resource.data.date)
          && request.resource.data.foodItem is map
          && isNonNegNumber(request.resource.data.foodItem.calories)
          && request.resource.data.foodItem.calories <= 10000;

        allow delete: if isOwner(userId);
      }

      // ── WATER ───────────────────────────────────────────────
      match /water/{waterId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isPositiveNumber(request.resource.data.amount)
          && request.resource.data.amount <= 5000
          && isDateStr(request.resource.data.date);

        allow delete: if isOwner(userId);
      }

      // ── WORKOUTS ────────────────────────────────────────────
      match /workouts/{workoutId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isString(request.resource.data.name)
          && isDateStr(request.resource.data.date)
          && request.resource.data.exercises is list;

        allow delete: if isOwner(userId);
      }

      // ── WORKOUT TEMPLATES ───────────────────────────────────
      match /workoutTemplates/{templateId} {
        allow read, write: if isOwner(userId);
      }

      // ── PERSONAL RECORDS ────────────────────────────────────
      match /personalRecords/{exerciseId} {
        allow read: if isOwner(userId);

        allow write: if isOwner(userId)
          && isString(request.resource.data.exerciseId)
          && isNonNegNumber(request.resource.data.weightKg)
          && isPositiveNumber(request.resource.data.reps);

        allow delete: if isOwner(userId);
      }

      // ── MEASUREMENTS ────────────────────────────────────────
      match /measurements/{measurementId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId)
          && isDateStr(request.resource.data.date)
          // At least one body measurement must be present
          && (('weight' in request.resource.data && isPositiveNumber(request.resource.data.weight))
              || ('waist' in request.resource.data && isPositiveNumber(request.resource.data.waist))
              || ('chest' in request.resource.data && isPositiveNumber(request.resource.data.chest))
              || ('hips'  in request.resource.data && isPositiveNumber(request.resource.data.hips))
              || ('arms'  in request.resource.data && isPositiveNumber(request.resource.data.arms))
              || ('thighs' in request.resource.data && isPositiveNumber(request.resource.data.thighs)));

        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // ── HABITS ──────────────────────────────────────────────
      match /habits/{habitId} {
        allow read, write: if isOwner(userId);
      }

      // ── PROGRESS PHOTOS ─────────────────────────────────────
      match /progressPhotos/{photoId} {
        allow read, write: if isOwner(userId);
      }

      // ── STREAKS ─────────────────────────────────────────────
      match /streaks/{streakId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ============================================================
    // SHARED FOOD DATABASE — read-only for authenticated users
    // ============================================================
    match /foods/{foodId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /foodCache/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /indianFoods/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ============================================================
    // SHARED EXERCISE DATABASE — read-only for authenticated users
    // ============================================================
    match /exercises/{exerciseId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /exerciseCache/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ============================================================
    // DENY EVERYTHING ELSE
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
