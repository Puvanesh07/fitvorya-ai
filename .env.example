# ── Firebase (client-side — safe to expose) ───────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── Netlify Functions (only used in local dev with `netlify dev`) ─────────────
# In production these live in Netlify Dashboard > Site > Environment Variables
# They are NEVER exposed to the browser — server-side only.

# USDA FoodData Central — free key at https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=your_usda_api_key

# ExerciseDB via RapidAPI — free tier at https://rapidapi.com/justin-WFnsXH_t6/api/exercisedb
EXERCISEDB_API_KEY=your_exercisedb_rapidapi_key

# ── Local dev: point Vite at the Netlify Dev server ──────────────────────────
# Create a .env.local file (gitignored) with this line when running netlify dev:
# VITE_NETLIFY_BASE=http://localhost:8888
